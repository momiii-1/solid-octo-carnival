function saveAnnivCard(u,m){
  const W=750,H=1080,c=document.createElement('canvas');c.width=W;c.height=H;
  const x=c.getContext('2d');
  const g=x.createLinearGradient(0,0,W,H);
  g.addColorStop(0,'#16030a');g.addColorStop(.5,'#330812');g.addColorStop(1,'#0a0206');
  x.fillStyle=g;x.fillRect(0,0,W,H);
  // 星点
  let seed=42;const rnd=()=>{seed=(seed*16807)%2147483647;return seed/2147483647;};
  for(let i=0;i<70;i++){
    x.fillStyle='rgba(255,214,203,'+(0.25+rnd()*0.5)+')';
    const r=rnd()*1.8+.5;x.beginPath();x.arc(rnd()*W,rnd()*H,r,0,7);x.fill();
  }
  // 四角星
  function star(cx,cy,R,color,glow){
    x.save();x.translate(cx,cy);x.shadowColor=glow;x.shadowBlur=42;
    x.fillStyle=color;x.beginPath();
    x.moveTo(0,-R);x.bezierCurveTo(R*.16,-R*.22,R*.22,-R*.16,R,0);
    x.bezierCurveTo(R*.22,R*.16,R*.16,R*.22,0,R);
    x.bezierCurveTo(-R*.16,R*.22,-R*.22,R*.16,-R,0);
    x.bezierCurveTo(-R*.22,-R*.16,-R*.16,-R*.22,0,-R);
    x.fill();x.restore();
  }
  star(W/2,330,120,u.star2||'#ef233c',u.star1||'#d90429');
  star(W/2-150,250,26,u.star1||'#d90429',u.star2||'#ef233c');
  star(W/2+160,400,20,u.star1||'#d90429',u.star2||'#ef233c');
  x.textAlign='center';
  x.fillStyle='rgba(240,136,122,.75)';x.font='20px Georgia,serif';x.letterSpacing='6px';
  x.fillText('S U   U N I V E R S E',W/2,118);
  x.fillStyle='#ff8a7a';x.font='26px "Microsoft YaHei",sans-serif';
  x.fillText('认 识 的 第 '+m.day+' 天',W/2,540);
  // 正文自动换行
  x.fillStyle='#ffd6cb';x.font='30px "Microsoft YaHei",sans-serif';x.textBaseline='middle';
  const maxW=560;const chars=[...m.text];const lines=[];let line='';
  for(const ch of chars){if(x.measureText(line+ch).width>maxW){lines.push(line);line=ch;}else line+=ch;}
  if(line)lines.push(line);
  const y0=630;
  lines.slice(0,5).forEach((t,i)=>x.fillText(t,W/2,y0+i*52));
  x.fillStyle='rgba(240,136,122,.8)';x.font='22px "Microsoft YaHei",sans-serif';
  const d=new Date(m.ts);
  x.fillText(u.name+' · '+d.getFullYear()+'.'+(d.getMonth()+1)+'.'+d.getDate(),W/2,980);
  try{
    const a=document.createElement('a');
    a.download='SU宇宙·认识第'+m.day+'天.png';
    a.href=c.toDataURL('image/png');a.click();
    toast('纪念卡已保存到下载');
