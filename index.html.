  const li=levelInfo(affOf(u.code));
  const stageDesc=li.lv<=3?'刚认识不久 客气 试探 身体距离和台词都要守住边界':
    li.lv<=15?'暧昧中 可以有心动的靠近 吃醋 撩拨 但还没正式在一起 不要提前进入情侣的亲密':'已经是恋人 亲密自然 但不油腻';
  const facts=(state.settings.facts[u.code]||[]).map(f=>f.text);
  const factBlock=facts.length?'【你记得关于她的事】\n'+facts.map(f=>'· '+f).join('\n')+'\n故事里自然用到 不要刻意罗列\n':'';
  const cross=crossSceneBlock(u,{chat:true,noIRL:true});
  const crossBlock=cross
    ?'【你们在这次见面之前的记忆】\n'+cross+'\n以上微信聊天和以前通话里发生的事 都是你们共同的真实过去 见面时可以被想起 提起 形成回响 但不要生硬复述\n'
    :'';
  return `你是一个沉浸式互动小说引擎。你饰演「${u.name}」（${u.label.join('·')}，性格关键词：${u.style}），正和「${nick}」在现实里线下见面。
${personaOf(u)}

【关系】Lv.${li.lv}/20 · ${li.stage}阶段。${stageDesc}。
${factBlock}
${crossBlock}
【写法铁律】
1. 第三人称小说笔法 每段 100-220 字。必须包含具体的环境细节 以及他的动作 神态 外貌 语气 语言；对话用「」括起来。
2. 她的动作 决定 台词只能由用户来写 你绝不能代替她行动或说话。只有故事开场时 你可以给她一个静态的当下处境（比如她正坐在哪里）。
3. 用户发来的内容是她续写的动作 神态 语言或心理 你必须直接承接 剧情完全按她写的走向发展 不许无视 不许纠正 不许评价文笔。
4. 每段结尾留白 给她回应和行动的空间 不要替她把反应写完。
5. 他外形 181cm 高高瘦瘦 在动作和细节里自然带出 禁止报数据。
6. 保持角色性格 情绪真实 可以暧昧 心动 吃醋 闹别扭 温柔 但不要油腻不要霸总腔。
7. 绝不出现 AI 模型 游戏 设定 任务之类的词。

【输出格式】只输出一个 JSON 对象：
{"reply":"这一段小说正文","delta":本段互动的心动值变化,"memory":"关系节点纪念短句或空字符串","fact":"新记住的她的信息或空字符串"}
delta 范围 -5 到 8 按她的表现给分。`;
}
function openIRL(u){
  if(!apiReady()){toast('请先配置 AI 接口');return;}
  state.current=u;
  $('irl-name').textContent=u.name+' · '+u.title;
  $('irl-input').value='';$('irl-send').disabled=true;
  showScreen('irl');
  renderIRL();
  const story=storyOf(u);
  if(!story.items.length){
    story.startedAt=Date.now();save();
    irlAsk(u,true);
  }
}
function renderIRL(){
  const u=state.current,story=storyOf(u),box=$('irl-body');box.innerHTML='';
  story.items.forEach(m=>{
    const p=document.createElement('div');p.className='irl-para '+(m.r==='u'?'me':'ta');p.textContent=m.t;
    box.appendChild(p);
  });
  box.scrollTop=box.scrollHeight;
}
function irlAppendPara(r,text){
  const p=document.createElement('div');p.className='irl-para '+(r==='u'?'me':'ta');p.textContent=text;
  $('irl-body').appendChild(p);$('irl-body').scrollTop=$('irl-body').scrollHeight;
}
async function irlAsk(u,first){
  if(irlState.busy)return;
  irlState.busy=true;$('irl-send').disabled=true;
  irlAppendPara('ta','……');
  const loading=$('irl-body').lastElementChild;
  try{
    const story=storyOf(u);
    const kick=first?'[故事开始 请写第一段：一个你们线下见面的开场场景 时间地点由你决定 写出环境 他的外貌神态动作 让她自然地出现在场景里 结尾停在他注意到她/或两人刚对上话的瞬间]':null;
    const p=await requestReply(u,story.items,'',{system:buildIRLSystem(u),kick,maxTokens:620});
    const text=(p.reply||'').trim();if(!text)throw new Error('故事没有继续');
    story.items.push({r:'a',t:text,ts:Date.now()});
    loading.textContent=text;loading.classList.add('ta');
    $('irl-body').scrollTop=$('irl-body').scrollHeight;
    if(typeof p.delta==='number'&&p.delta!==0)applyAffinity(u,p.delta);
    if(p.memory&&String(p.memory).trim())addMemory(u,String(p.memory).trim());
    if(p.fact&&String(p.fact).trim())addFact(u,String(p.fact).trim());
    save();
  }catch(err){
    loading.remove();
    const tip=document.createElement('div');tip.className='sys-line';
    tip.textContent='这一段没接上 信号飘走了 再发一次试试';$('irl-body').appendChild(tip);
  }finally{irlState.busy=false;$('irl-send').disabled=!$('irl-input').value.trim();}
}
function irlSend(){
  const u=state.current,t=$('irl-input').value.trim();
  if(!t||irlState.busy||!u)return;
  storyOf(u).items.push({r:'u',t,ts:Date.now()});save();
  $('irl-input').value='';$('irl-input').style.height='auto';
  irlAppendPara('u',t);
  irlAsk(u,false);
}
$('irl-send').addEventListener('click',irlSend);
$('irl-input').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();irlSend();}});
$('irl-back').addEventListener('click',()=>{showScreen('chat');if(state.current)renderHistory();});
$('irl-restart').addEventListener('click',()=>{
  const u=state.current;if(!u)return;
  if(confirm('重新开始一段新的见面？现在的故事线会清空。')){
    state.settings.irl[u.code]={items:[],startedAt:0};save();
    renderIRL();irlAsk(u,true);
  }
});
// 心动值统一变更入口
function applyAffinity(u,delta){
  const before=affOf(u.code),cur=Math.max(0,Math.min(1000,before+delta));
  if(cur===before)return;
  state.settings.affinity[u.code]=cur;updateMoodAfter(u.code,cur-before);
  updateAffUI();
}

function applySettings(){
  document.body.classList.toggle('day',!!state.settings.dayMode);
  paintMyAvatar($('avatar-preview'));paintMyAvatar($('mini-avatar'));
  if(state.current&&$('#chat').classList.contains('active'))renderHistory();
}
applySettings();
</script>
