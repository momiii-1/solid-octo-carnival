// 模型没按 lines 返回时的客户端拆句兜底
function splitReplyBubbles(text){
  const byLine=text.split(/\n+/).map(s=>s.trim()).filter(Boolean);
  if(byLine.length>1)return byLine.slice(0,3);
  const parts=text.match(/[^？！?！\n]+[？！?！]?/g);
  if(parts&&parts.length>1){
    const out=[];let buf='';
    parts.forEach(x=>{x=x.trim();if(!x)return;
      if((buf+x).length<=18)buf+=x;else{if(buf)out.push(buf);buf=x;}});
    if(buf)out.push(buf);
    return out.slice(0,3);
  }
  return [text.trim()];
}
// 统一的一次对话请求（聊天 / 通话 / 线下共用）
async function requestReply(u,history,extra,opts){
  opts=opts||{};
  const messages=[{role:'system',content:opts.system||buildSystem(u,extra)}];
  (history||[]).slice(-30).forEach(m=>messages.push({role:m.r==='u'?'user':'assistant',content:m.t}));
  if(opts.kick)messages.push({role:'user',content:opts.kick});
  const raw=await apiRequest(u,messages,opts.maxTokens||420);
  return parseReply(raw);
}
async function apiRequest(u,messages,maxTokens){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),60000);
  try{
    const resp=await fetch(endpoint(),{method:'POST',signal:ctrl.signal,
      headers:{'Content-Type':'application/json','Authorization':'Bearer '+state.settings.apiKey.trim()},
      body:JSON.stringify({model:state.settings.model.trim(),messages,temperature:.95,max_tokens:maxTokens||400})});
    if(!resp.ok){let detail=resp.status+' '+resp.statusText;try{detail=(await resp.json()).error?.message||detail;}catch(_){}throw new Error(detail);}
    const data=await resp.json();
    return data.choices?.[0]?.message?.content||'';
  }finally{clearTimeout(timer);}
}
