// 所有星芒渐变统一定义一次，避免同一 id 在页面中重复定义导致部分引用渲染失败
function syncSvgDefs(){
  let host=document.getElementById('svg-defs-host');
  if(!host){host=document.createElementNS('http://www.w3.org/2000/svg','svg');
    host.setAttribute('id','svg-defs-host');host.setAttribute('width','0');host.setAttribute('height','0');
    host.style.position='absolute';host.style.width='0';host.style.height='0';host.style.overflow='hidden';
    document.body.insertBefore(host,document.body.firstChild);}
  host.innerHTML='<defs>'+allChars().map(u=>
    `<linearGradient id="${GID(u.code)}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${u.star1}"/><stop offset="1" stop-color="${u.star2}"/></linearGradient>`
  ).join('')+'</defs>';
}
