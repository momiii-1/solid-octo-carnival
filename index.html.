  const raw=await apiRequest(u,[{role:'system',content:sys},
    {role:'user',content:'[你们的关系阶段：'+li.stage+']\n[她最近和你聊过：'+(recent||'还没怎么聊过')+']\n\n请输出朋友圈内容的JSON，格式 {"reply":"朋友圈正文","delta":0}。'}],150);
  return (parseReply(raw).reply||'').trim();
