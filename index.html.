<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>SU UNIVERSE · 平行宇宙</title>
<style>
/* ============================================================
   SU UNIVERSE —— 绯血红 × 纯黑星空
   ============================================================ */
:root{
  --red:#d90429;--red-hot:#ef233c;--red-deep:#6a040f;
  --coral:#f0887a;--mist:#ffd6cb;--ember:#ff6b5e;--hi:#fff1ec;
  --ink:#ffede8;--ink-dim:rgba(255,237,232,.58);
  --bg:#0a0306;--glass:rgba(24,9,14,.66);--glass-2:rgba(255,255,255,.055);
  --panel:rgba(19,7,11,.96);--line:rgba(232,62,78,.22);--hairline:rgba(255,255,255,.08);
  --bubble-me:#e8203c;
}
body.day{
  --ink:#432029;--ink-dim:rgba(67,32,41,.6);--bg:#fdf4ef;
  --glass:rgba(255,248,245,.82);--glass-2:rgba(120,30,45,.05);
  --panel:rgba(255,253,252,.97);--line:rgba(217,4,41,.18);--hairline:rgba(80,20,30,.1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;}
body{font-family:"PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;background:#000;color:var(--ink);overflow:hidden;transition:background .5s,color .5s;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,textarea{font-family:inherit;}

#app{position:relative;width:100%;max-width:480px;height:100%;margin:0 auto;overflow:hidden;
  background:
    radial-gradient(72% 48% at 16% 6%,rgba(223,32,56,.24),transparent 70%),
    radial-gradient(90% 62% at 86% 26%,rgba(120,10,22,.55),transparent 74%),
    radial-gradient(78% 52% at 50% 104%,rgba(217,4,41,.18),transparent 72%),
    linear-gradient(180deg,#150509 0%,var(--bg) 55%,#050103 100%);}
body.day #app{background:
    radial-gradient(70% 46% at 18% 8%,rgba(240,128,114,.28),transparent 70%),
    radial-gradient(85% 55% at 88% 30%,rgba(217,64,64,.14),transparent 72%),
    linear-gradient(180deg,#fff7f3 0%,var(--bg) 70%);}
.nebula{position:absolute;border-radius:50%;filter:blur(60px);pointer-events:none;opacity:.5;}
.nebula.n1{width:260px;height:260px;left:-90px;top:12%;background:rgba(223,32,56,.18);animation:drift 18s ease-in-out infinite;}
.nebula.n2{width:240px;height:240px;right:-90px;bottom:6%;background:rgba(160,20,36,.22);animation:drift 22s ease-in-out infinite reverse;}
@keyframes drift{0%,100%{transform:translate(0,0);}50%{transform:translate(24px,-20px);}}
#starfield{position:absolute;inset:0;pointer-events:none;}
.star{position:absolute;border-radius:50%;background:var(--mist);animation:twinkle var(--dur,3s) ease-in-out infinite;animation-delay:var(--delay,0s);}
@keyframes twinkle{0%,100%{opacity:.12;transform:scale(.6);}50%{opacity:.9;transform:scale(1.1);}}

.screen{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;visibility:hidden;transform:scale(1.02);
  transition:opacity .55s ease,transform .55s ease,visibility .55s;z-index:2;}
.screen.active{opacity:1;visibility:visible;transform:scale(1);z-index:5;}

/* ================= 开场 ================= */
#opening{align-items:center;justify-content:center;}
.opening-title{position:absolute;top:7%;font-size:11px;letter-spacing:.62em;text-indent:.62em;color:rgba(240,128,114,.7);}
.su-stage{position:relative;width:300px;height:300px;display:flex;align-items:center;justify-content:center;}
.orbit-ring{position:absolute;border-radius:50%;border:1px solid rgba(232,62,78,.16);animation:spin var(--rt,40s) linear infinite;animation-delay:var(--rd,0s);}
.ring-o{width:300px;height:300px;--rt:48s;}
.ring-m{width:224px;height:224px;--rt:36s;--rd:-12s;border-style:dashed;border-color:rgba(240,128,114,.14);}
.ring-i{width:148px;height:148px;--rt:26s;--rd:-9s;}
.orbit-planet{position:absolute;top:-5px;left:50%;width:9px;height:9px;border-radius:50%;transform:translateX(-50%);box-shadow:0 0 10px 2px rgba(239,35,60,.7);animation:cspin var(--rt,40s) linear infinite;animation-delay:var(--rd,0s);}
.ring-o .orbit-planet{background:var(--red-hot);}
.ring-m .orbit-planet{background:var(--coral);}
.ring-i .orbit-planet{background:var(--ember);box-shadow:0 0 10px 2px rgba(255,107,94,.7);}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes cspin{to{transform:translateX(-50%) rotate(-360deg);}}
.su-wrap{position:relative;z-index:3;width:220px;animation:suFloat 4s ease-in-out infinite;}
@keyframes suFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-7px);}}
.su-svg{width:100%;display:block;overflow:visible;filter:drop-shadow(0 0 16px rgba(239,35,60,.45));}
.su-stroke{fill:none;stroke:url(#suInk);stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:100;stroke-dashoffset:100;animation:penWrite 1.5s cubic-bezier(.5,0,.2,1) forwards;}
.su-stroke.s2{animation-delay:1.25s;}
@keyframes penWrite{to{stroke-dashoffset:0;}}
.su-spark{position:absolute;top:6px;right:14px;color:var(--mist);font-size:15px;opacity:0;animation:sparkPop 2.2s ease-in-out 2.6s infinite;text-shadow:0 0 12px rgba(255,214,203,.9);}
@keyframes sparkPop{0%,100%{opacity:0;transform:scale(.4) rotate(0);}50%{opacity:1;transform:scale(1.15) rotate(90deg);}}
.loading-wrap{position:absolute;bottom:13%;width:220px;text-align:center;}
.loading-bar{height:2px;background:rgba(232,62,78,.16);border-radius:2px;overflow:hidden;}
.loading-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--red),var(--coral));box-shadow:0 0 12px rgba(239,35,60,.7);transition:width .12s linear;}
.loading-pct{margin-top:10px;font-size:11px;letter-spacing:.5em;text-indent:.5em;color:rgba(240,128,114,.6);}
.enter-btn{margin-top:20px;padding:12px 30px;font-size:12px;letter-spacing:.45em;text-indent:.45em;color:var(--hi);
  border:1px solid rgba(240,128,114,.5);border-radius:99px;background:linear-gradient(135deg,rgba(217,4,41,.3),rgba(239,35,60,.2));
  opacity:0;pointer-events:none;transition:opacity .8s;animation:btnGlow 2.6s ease-in-out infinite;}
.enter-btn.show{opacity:1;pointer-events:auto;}
.enter-btn:active{transform:scale(.96);}
@keyframes btnGlow{0%,100%{box-shadow:0 0 10px rgba(239,35,60,.25);}50%{box-shadow:0 0 30px rgba(239,35,60,.6);}}

/* ================= 星图 ================= */
.main-header{position:absolute;top:22px;right:24px;text-align:right;z-index:6;}
.main-header .en{font-size:18px;letter-spacing:.08em;font-style:italic;font-weight:600;
  background:linear-gradient(120deg,var(--mist),var(--coral) 60%,var(--red-hot));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.main-header .sub{margin-top:6px;font-size:10px;letter-spacing:.3em;color:var(--ink-dim);}
.universe-stage{flex:1;display:flex;align-items:center;justify-content:center;}
.u-orbit{position:relative;width:100%;height:100%;--tilt:63deg;
  transform:perspective(1300px) rotateX(var(--tilt));transform-style:preserve-3d;}
.u-ring{position:absolute;top:50%;left:50%;border-radius:50%;border:1px solid rgba(232,62,78,.16);
  transform-style:preserve-3d;animation:spin var(--ut) linear infinite;animation-delay:var(--ud);}
.u-ring.dashed{border-style:dashed;border-color:rgba(240,128,114,.15);}
.u-ring.r0{border-color:rgba(232,62,78,.07);animation:none;}
.star-carrier{position:absolute;top:0;left:50%;transform-style:preserve-3d;
  animation:hold var(--ut) linear infinite;animation-delay:var(--ud);}
@keyframes hold{from{transform:translateX(-50%) rotateZ(0);}to{transform:translateX(-50%) rotateZ(-360deg);}}
.u-core{position:absolute;top:50%;left:50%;z-index:4;width:54px;height:54px;display:flex;align-items:center;justify-content:center;
  transform:translate(-50%,-50%) rotateX(calc(var(--tilt)*-1)) translateZ(6px);transform-style:preserve-3d;}
.u-core .star-svg{width:100%;animation:coreStar 3s ease-in-out infinite;}
@keyframes coreStar{0%,100%{transform:scale(1) rotate(0);filter:drop-shadow(0 0 10px rgba(240,128,114,.5));}50%{transform:scale(1.12) rotate(12deg);filter:drop-shadow(0 0 22px rgba(240,128,114,.85));}}
.star-btn{padding:0;z-index:5;display:flex;flex-direction:column;align-items:center;
  transform:translateX(-50%) translateY(-50%) rotateX(calc(var(--tilt)*-1)) translateZ(8px);transform-style:preserve-3d;}
.star-orb{position:relative;width:74px;height:74px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,rgba(239,35,60,.14),transparent 70%);transition:transform .3s;}
.star-btn:active .star-orb{transform:scale(.88);}
.star-orb .ring-svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg);}
.ring-bg{fill:none;stroke:rgba(240,128,114,.14);stroke-width:1.6;}
.ring-prog{fill:none;stroke:var(--ringc,var(--coral));stroke-width:2;stroke-linecap:round;stroke-dasharray:207;stroke-dashoffset:207;filter:drop-shadow(0 0 5px var(--ringc,var(--coral)));transition:stroke-dashoffset .9s ease;}
.star-shape{width:40px;height:40px;animation:starPulse 2.8s ease-in-out infinite;}
@keyframes starPulse{0%,100%{transform:scale(.92);filter:drop-shadow(0 0 6px rgba(239,35,60,.35));}50%{transform:scale(1.08);filter:drop-shadow(0 0 18px rgba(239,35,60,.8));}}
.star-svg{display:block;width:100%;height:100%;}
.planet-code{margin-top:4px;font-size:9px;letter-spacing:.2em;color:var(--coral);white-space:nowrap;text-shadow:0 0 10px rgba(223,32,56,.6);}
.unread-badge{position:absolute;top:0;right:-2px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:var(--red-hot);
  color:#fff;font-size:9.5px;font-weight:700;display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 9px rgba(239,35,60,.9);border:1px solid #2a060c;z-index:3;animation:badgePop .4s ease;}
@keyframes badgePop{from{transform:scale(0);}to{transform:scale(1);}}
.main-hint{position:absolute;bottom:96px;width:100%;text-align:center;font-size:11px;letter-spacing:.34em;text-indent:.34em;color:var(--ink-dim);}
.main-hint::before,.main-hint::after{content:"";display:inline-block;width:26px;height:1px;background:rgba(240,128,114,.4);vertical-align:middle;margin:0 12px;}
.fab{position:absolute;bottom:26px;z-index:8;height:42px;border-radius:21px;border:1px solid var(--line);
  background:var(--glass);backdrop-filter:blur(6px);display:flex;align-items:center;gap:7px;padding:0 15px;
  font-size:12px;letter-spacing:.18em;color:var(--coral);}
.fab:active{transform:scale(.95);}
#open-settings{left:22px;width:42px;padding:0;justify-content:center;border-radius:50%;}
#open-moments{right:22px;}
#moments-dot{position:absolute;top:-4px;right:-4px;width:10px;height:10px;border-radius:50%;background:var(--red-hot);
  box-shadow:0 0 8px rgba(239,35,60,1);border:1.5px solid var(--bg);display:none;}
#moments-dot.show{display:block;}
.mini-avatar{position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--coral);background:var(--red-deep);
  background-size:cover;background-position:center;font-size:9px;display:flex;align-items:center;justify-content:center;color:var(--hi);}

/* ================= 弹窗 ================= */
.mask{position:absolute;inset:0;z-index:20;background:rgba(10,3,8,.72);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:28px;
  opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s;}
.mask.show{opacity:1;visibility:visible;}
.popup-card{width:100%;max-width:342px;background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:28px 26px 22px;text-align:center;position:relative;
  max-height:86%;overflow-y:auto;
  transform:translateY(18px) scale(.97);transition:transform .45s cubic-bezier(.2,.8,.25,1);
  box-shadow:0 18px 60px rgba(0,0,0,.55),0 0 50px rgba(217,4,41,.12),inset 0 0 40px rgba(239,35,60,.05);}
.mask.show .popup-card{transform:translateY(0) scale(1);}
.popup-orb{width:82px;height:82px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;animation:starPulse 3s ease-in-out infinite;}
.popup-code{font-size:10px;letter-spacing:.4em;text-indent:.4em;color:rgba(240,128,114,.65);}
.popup-name{margin-top:8px;font-size:26px;letter-spacing:.12em;color:var(--hi);text-shadow:0 0 22px rgba(239,35,60,.5);}
.popup-tags{margin-top:12px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
.tag{font-size:10px;letter-spacing:.14em;padding:3px 11px;border-radius:99px;border:1px solid var(--line);color:var(--coral);}
.tag.style-tag{background:rgba(217,4,41,.2);color:#f5b0a0;border-color:rgba(239,35,60,.45);}
.popup-desc{margin-top:16px;font-size:13px;line-height:1.95;color:var(--ink-dim);text-align:left;}
.popup-progress{margin-top:14px;font-size:10px;letter-spacing:.2em;color:var(--coral);}
.popup-actions{margin-top:20px;display:flex;gap:10px;}
.btn-primary,.btn-ghost{flex:1;padding:12px 0;font-size:13px;border-radius:99px;transition:all .25s;letter-spacing:.2em;}
.btn-primary{background:linear-gradient(135deg,var(--red),var(--red-hot));color:#fff;box-shadow:0 6px 20px rgba(217,4,41,.42);}
.btn-primary:active{transform:scale(.97);}
.btn-ghost{border:1px solid var(--line);color:var(--ink-dim);}
.btn-ghost:active{background:rgba(232,62,78,.1);}

/* ================= 聊天 ================= */
.chat-header{padding:12px 14px 10px;background:var(--glass);backdrop-filter:blur(14px);border-bottom:1px solid var(--hairline);z-index:6;}
.chat-top{display:flex;align-items:center;gap:10px;}
.back-btn{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--coral);flex-shrink:0;}
.back-btn:active{background:rgba(255,255,255,.07);}
.ta-avatar{width:40px;height:40px;border-radius:50%;flex-shrink:0;overflow:hidden;border:1px solid rgba(240,128,114,.32);
  box-shadow:0 0 14px rgba(239,35,60,.22);background:rgba(232,62,78,.08);display:flex;align-items:center;justify-content:center;}
.ta-avatar img{width:100%;height:100%;object-fit:cover;}
.ta-avatar .star-svg{width:74%;height:74%;}
.chat-meta{flex:1;min-width:0;}
.ta-title{font-size:14.5px;font-weight:600;letter-spacing:.06em;display:flex;align-items:baseline;gap:7px;}
.ta-title .ucode{font-size:8.5px;color:rgba(240,128,114,.58);letter-spacing:.18em;font-weight:400;}
.ta-status{font-size:10.5px;color:var(--ink-dim);margin-top:1px;display:flex;align-items:center;}
.ta-status.thinking{color:var(--coral);}
.ta-status.good{color:#ff9a8f;}
.ta-status.bad{color:#9aa0b0;}
.ta-status .dot{width:5px;height:5px;border-radius:50%;background:#ff7e6b;margin-right:5px;}
.ta-status.thinking .dot{background:var(--coral);animation:blink 1s infinite;}
@keyframes blink{50%{opacity:.25;}}
.aff-chip{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--coral);flex-shrink:0;padding:4px 9px;border-radius:99px;background:rgba(232,62,78,.1);border:1px solid rgba(232,62,78,.22);}
.aff-chip .h{color:var(--red-hot);}
.aff-line{margin-top:9px;height:2.5px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden;}
.aff-line i{display:block;height:100%;width:0%;border-radius:3px;background:linear-gradient(90deg,var(--red-hot),var(--coral));box-shadow:0 0 8px rgba(239,35,60,.8);transition:width .9s cubic-bezier(.2,.8,.3,1);}

.chat-body{flex:1;overflow-y:auto;padding:16px 14px 8px;display:flex;flex-direction:column;gap:4px;scrollbar-width:none;}
.chat-body::-webkit-scrollbar{display:none;}
.day-line{align-self:center;font-size:10px;letter-spacing:.14em;color:rgba(255,190,170,.62);margin:10px 0 2px;}
.sys-line{align-self:center;max-width:92%;text-align:center;font-size:10px;letter-spacing:.12em;line-height:1.8;color:rgba(255,190,170,.8);
  background:linear-gradient(90deg,transparent,rgba(217,4,41,.16),transparent);padding:4px 14px;border-radius:99px;margin:8px 0;}
.msg{display:flex;gap:7px;max-width:82%;align-items:flex-end;margin-top:10px;animation:bubbleIn .32s cubic-bezier(.2,.8,.3,1.15);}
@keyframes bubbleIn{from{opacity:0;transform:translateY(7px);}to{opacity:1;transform:none;}}
.msg.me{align-self:flex-end;flex-direction:row-reverse;}
.msg-avatar{width:30px;height:30px;border-radius:50%;flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;
  background-size:cover;background-position:center;margin-bottom:1px;}
.msg.ta .msg-avatar{background:rgba(232,62,78,.08);border:1px solid rgba(240,128,114,.22);}
.msg.ta .msg-avatar .star-svg{width:72%;height:72%;}
.msg.me .msg-avatar{background:var(--red-deep);border:1px solid rgba(240,128,114,.4);color:var(--hi);font-size:11px;}
.bubble{padding:9.5px 14px;font-size:14.5px;line-height:1.62;word-break:break-word;white-space:pre-wrap;}
.msg.me .bubble{background:var(--bubble-me);color:#fff;border-radius:20px 20px 5px 20px;
  box-shadow:0 3px 12px rgba(217,4,41,.35),inset 0 1px 0 rgba(255,255,255,.14);}
.msg.ta .bubble{background:var(--glass-2);border:1px solid var(--hairline);color:var(--ink);border-radius:20px 20px 20px 5px;backdrop-filter:blur(4px);}
body.day .msg.ta .bubble{background:rgba(255,255,255,.85);border-color:rgba(80,20,30,.08);box-shadow:0 2px 10px rgba(120,30,45,.06);}
.typing{display:inline-flex;gap:4.5px;padding:4px 2px;}
.typing i{width:6.5px;height:6.5px;border-radius:50%;background:var(--coral);animation:typing 1.2s infinite;}
.typing i:nth-child(2){animation-delay:.18s;}
.typing i:nth-child(3){animation-delay:.36s;}
@keyframes typing{0%,60%,100%{transform:translateY(0);opacity:.35;}30%{transform:translateY(-5px);opacity:1;}}
.err-bubble{font-size:12.5px;line-height:1.7;color:#ffb3ab;}
.err-bubble b{color:var(--coral);font-weight:600;}
.err-bubble button{margin-top:7px;font-size:11.5px;color:var(--hi);background:rgba(217,4,41,.55);border:1px solid rgba(240,128,114,.5);padding:5px 13px;border-radius:99px;letter-spacing:.1em;}
.score-float{position:absolute;top:88px;right:20px;z-index:7;pointer-events:none;font-size:12.5px;font-weight:600;opacity:0;}
.score-float.go{animation:floatUp 1.5s ease-out forwards;}
.score-float.up{color:var(--coral);text-shadow:0 0 14px rgba(239,35,60,.8);}
.score-float.down{color:#aab2cc;}
@keyframes floatUp{0%{opacity:0;transform:translateY(8px) scale(.8);}20%{opacity:1;transform:translateY(0) scale(1.08);}100%{opacity:0;transform:translateY(-28px) scale(1);}}

.chat-dock{padding:8px 12px calc(12px + env(safe-area-inset-bottom));background:linear-gradient(180deg,transparent,rgba(10,3,6,.55) 30%);}
body.day .chat-dock{background:linear-gradient(180deg,transparent,rgba(253,244,239,.8) 30%);}
.input-dock{position:relative;display:flex;align-items:flex-end;gap:8px;background:var(--glass);border:1px solid var(--hairline);
  border-radius:26px;padding:6px 6px 6px 10px;backdrop-filter:blur(14px);transition:border-color .3s,box-shadow .3s;}
.input-dock:focus-within{border-color:rgba(240,128,114,.5);box-shadow:0 0 0 3px rgba(239,35,60,.1);}
.dock-input{flex:1;resize:none;max-height:92px;min-height:24px;background:transparent;border:none;font-size:14.5px;color:var(--ink);outline:none;line-height:1.55;padding:5px 0;}
.dock-input::placeholder{color:var(--ink-dim);}
.send-btn{width:38px;height:38px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--red),var(--red-hot));color:#fff;box-shadow:0 3px 12px rgba(217,4,41,.5);transition:transform .2s,opacity .25s;}
.send-btn:active{transform:scale(.85);}
.send-btn:disabled{background:rgba(255,255,255,.1);box-shadow:none;color:var(--ink-dim);}
.send-btn svg{width:17px;height:17px;margin-left:1px;}

/* ================= 朋友圈 ================= */
.mom-header{padding:14px 16px 12px;background:var(--glass);backdrop-filter:blur(14px);border-bottom:1px solid var(--hairline);
  display:flex;align-items:center;gap:10px;z-index:6;}
.mom-header h3{flex:1;font-size:15px;letter-spacing:.3em;color:var(--coral);}
.mom-refresh{font-size:11px;letter-spacing:.14em;padding:6px 13px;border-radius:99px;border:1px solid var(--line);color:var(--coral);}
.mom-refresh:disabled{opacity:.4;}
.mom-body{flex:1;overflow-y:auto;padding:16px 14px 90px;scrollbar-width:none;}
.mom-body::-webkit-scrollbar{display:none;}
.mom-empty{text-align:center;color:var(--ink-dim);font-size:12px;letter-spacing:.16em;line-height:2;margin-top:80px;}
.mom-card{display:flex;gap:11px;padding:14px 4px;border-bottom:1px solid var(--hairline);animation:bubbleIn .4s ease;}
.mom-av{width:42px;height:42px;border-radius:50%;flex-shrink:0;overflow:hidden;border:1px solid rgba(240,128,114,.28);background:rgba(232,62,78,.08);display:flex;align-items:center;justify-content:center;}
.mom-av img{width:100%;height:100%;object-fit:cover;}
.mom-av .star-svg{width:72%;height:72%;}
.mom-main{flex:1;min-width:0;}
.mom-top{display:flex;align-items:baseline;gap:8px;}
.mom-name{font-size:13.5px;font-weight:600;color:var(--coral);}
.mom-who{font-size:9.5px;color:var(--ink-dim);letter-spacing:.1em;}
.mom-time{margin-left:auto;font-size:9.5px;color:var(--ink-dim);flex-shrink:0;}
.mom-text{margin-top:5px;font-size:14px;line-height:1.7;color:var(--ink);word-break:break-word;white-space:pre-wrap;}
.mom-actions{margin-top:8px;display:flex;gap:20px;}
.mom-act{font-size:11.5px;color:var(--ink-dim);display:flex;align-items:center;gap:4px;letter-spacing:.08em;}
.mom-act.liked{color:var(--red-hot);}
.mom-comments{margin-top:9px;border-radius:12px;background:rgba(232,62,78,.07);padding:8px 11px;}
.mom-cm{font-size:12.5px;line-height:1.75;color:var(--ink);}
.mom-cm b{color:var(--coral);font-weight:600;margin-right:5px;}
.mom-cm.me b{color:var(--ember);}
.mom-cm + .mom-cm{margin-top:3px;}
.comment-dock{position:absolute;left:0;right:0;bottom:0;z-index:9;padding:8px 12px calc(10px + env(safe-area-inset-bottom));
  background:linear-gradient(180deg,transparent,rgba(10,3,6,.7) 28%);
  opacity:0;visibility:hidden;transform:translateY(12px);transition:.3s;}
.comment-dock.show{opacity:1;visibility:visible;transform:none;}
.comment-cancel{font-size:11px;color:var(--ink-dim);padding:0 6px;white-space:nowrap;}

/* ---------- 每日一问 ---------- */
.daily-chip{display:none;width:100%;margin-bottom:8px;padding:9px 14px;border-radius:99px;
  border:1px solid rgba(239,35,60,.45);background:rgba(239,35,60,.1);color:var(--coral);
  font-size:12px;letter-spacing:.06em;text-align:center;animation:bubbleIn .4s ease;}
.daily-chip.show{display:block;}
.daily-chip:active{background:rgba(239,35,60,.2);}

/* ---------- 消息头像（统一 img 规则） ---------- */
.msg-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.msg.me .msg-avatar{font-size:0;}
.msg.me .msg-avatar .av-fallback{font-size:11px;}
/* 同一人连发：中间气泡藏头像、收紧间距 */
.msg.nomid{margin-top:3px;}
.msg.nomid .msg-avatar{visibility:hidden;}
/* 时间与已读 */
.msg-meta{display:none;font-size:9.5px;color:rgba(255,190,170,.55);margin:3px 4px 2px;letter-spacing:.06em;}
.msg.show-meta .msg-meta{display:block;}
.msg.ta .msg-col{align-items:flex-start;}
.msg.me .msg-col{align-items:flex-end;}
.msg.me .msg-meta{color:rgba(255,190,170,.6);}
.msg.me .msg-meta.unread{color:var(--ember);}
.msg-col{display:flex;flex-direction:column;max-width:100%;min-width:0;}

/* ---------- 加号菜单 ---------- */
.plus-btn{width:32px;height:32px;border-radius:50%;flex-shrink:0;font-size:20px;line-height:1;color:var(--coral);
  background:rgba(239,35,60,.1);border:1px solid rgba(239,35,60,.3);display:flex;align-items:center;justify-content:center;
  transition:transform .3s,background .3s;}
.plus-btn:active{background:rgba(239,35,60,.22);}
.input-dock.plus-open .plus-btn{transform:rotate(45deg);background:rgba(239,35,60,.25);}
.plus-menu{position:absolute;left:10px;bottom:58px;z-index:20;display:flex;flex-direction:column;gap:8px;
  opacity:0;visibility:hidden;transform:translateY(10px) scale(.96);transform-origin:left bottom;transition:.22s;}
.input-dock.plus-open .plus-menu{opacity:1;visibility:visible;transform:none;}
.plus-item{display:flex;align-items:center;gap:9px;white-space:nowrap;padding:10px 18px 10px 13px;border-radius:99px;
  background:linear-gradient(135deg,rgba(60,12,22,.96),rgba(30,6,12,.96));border:1px solid rgba(239,35,60,.4);
  color:var(--ink);font-size:12.5px;letter-spacing:.14em;box-shadow:0 6px 22px rgba(0,0,0,.45);
  animation:bubbleIn .28s ease backwards;}
.plus-item:nth-child(1){animation-delay:.02s;}
.plus-item:nth-child(2){animation-delay:.07s;}
.plus-item:nth-child(3){animation-delay:.12s;}
.plus-item .pi-ic{font-size:15px;}
.plus-item:active{border-color:var(--coral);}

/* ================= 通话 ================= */
.call-mask{position:absolute;inset:0;z-index:40;display:none;flex-direction:column;
  background:radial-gradient(120% 90% at 50% 0%,#3a0812 0%,#1a050a 45%,#0a0205 100%);overflow:hidden;}
.call-mask.show{display:flex;animation:bubbleIn .35s ease;}
.call-glow{position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:420px;height:420px;border-radius:50%;
  background:radial-gradient(circle,rgba(239,35,60,.28),transparent 65%);pointer-events:none;}
.call-top{position:relative;z-index:2;text-align:center;padding:58px 20px 14px;flex-shrink:0;}
.call-avatar{width:96px;height:96px;border-radius:50%;margin:0 auto 16px;overflow:hidden;position:relative;
  border:2px solid rgba(239,35,60,.55);box-shadow:0 0 0 8px rgba(239,35,60,.08),0 0 46px rgba(239,35,60,.5);
  background:rgba(232,62,78,.1);display:flex;align-items:center;justify-content:center;animation:callPulse 2.4s ease-in-out infinite;}
.call-avatar img{width:100%;height:100%;object-fit:cover;}
.call-avatar .star-svg{width:66%;height:66%;}
@keyframes callPulse{0%,100%{box-shadow:0 0 0 8px rgba(239,35,60,.08),0 0 38px rgba(239,35,60,.4);}
  50%{box-shadow:0 0 0 15px rgba(239,35,60,.04),0 0 58px rgba(239,35,60,.62);}}
.call-name{font-size:21px;letter-spacing:.22em;color:var(--hi);font-weight:600;}
.call-status{margin-top:9px;font-size:12px;letter-spacing:.18em;color:var(--coral);}
.call-body{position:relative;z-index:2;flex:1;overflow-y:auto;padding:10px 16px;display:flex;flex-direction:column;gap:3px;scrollbar-width:none;}
.call-body::-webkit-scrollbar{display:none;}
.call-body .bubble{padding:8px 13px;font-size:14px;line-height:1.55;}
.call-body .msg{margin-top:7px;max-width:86%;}
.call-body .msg-avatar{display:none;}
.call-dock{position:relative;z-index:2;padding:8px 14px calc(14px + env(safe-area-inset-bottom));flex-shrink:0;
  background:linear-gradient(180deg,transparent,rgba(8,2,5,.75) 35%);}
.call-keys{display:flex;align-items:center;justify-content:center;gap:34px;margin-top:16px;}
.call-key{display:flex;flex-direction:column;align-items:center;gap:5px;color:rgba(255,214,203,.75);font-size:10px;letter-spacing:.14em;}
.call-key .ck-ic{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:21px;
  background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);transition:background .25s;}
.call-key.off .ck-ic{background:rgba(255,255,255,.22);}
.call-key.hangup .ck-ic{width:64px;height:64px;font-size:27px;color:#fff;background:linear-gradient(135deg,var(--red-hot),var(--red-deep));
  border-color:rgba(255,120,120,.5);box-shadow:0 6px 22px rgba(217,4,41,.5);transform:rotate(135deg);}

/* ================= 日记 ================= */
.diary-card{width:min(88vw,350px);max-height:82vh;display:flex;flex-direction:column;
  background:linear-gradient(160deg,#2a0a11 0%,#17050a 100%);border:1px solid rgba(239,35,60,.35);
  border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.6);}
.diary-head{padding:18px 20px 12px;border-bottom:1px solid rgba(239,35,60,.18);display:flex;align-items:flex-start;justify-content:space-between;}
.diary-title{font-size:15px;letter-spacing:.3em;color:var(--coral);display:flex;flex-direction:column;gap:6px;}
.diary-lock{font-size:9.5px;letter-spacing:.12em;color:rgba(255,190,170,.5);font-weight:400;}
.diary-x{color:var(--ink-dim);font-size:15px;padding:2px 4px;}
.diary-body{flex:1;overflow-y:auto;padding:16px 20px;scrollbar-width:none;}
.diary-body::-webkit-scrollbar{width:0;}
.diary-empty{text-align:center;color:var(--ink-dim);font-size:12px;letter-spacing:.14em;line-height:2.1;padding:42px 0;}
.diary-entry{border-bottom:1px dashed rgba(239,35,60,.2);padding:4px 0 18px;margin-bottom:18px;}
.diary-entry:last-child{border-bottom:none;margin-bottom:0;}
.diary-date{font-size:10.5px;letter-spacing:.2em;color:var(--ember);margin-bottom:9px;}
.diary-text{font-size:14px;line-height:2.05;color:rgba(255,236,230,.92);white-space:pre-wrap;word-break:break-word;
  font-family:"Songti SC","SimSun",Georgia,serif;}
.diary-foot{padding:12px 20px 18px;border-top:1px solid rgba(239,35,60,.18);}
.diary-new{width:100%;padding:12px;font-size:12.5px;letter-spacing:.24em;text-indent:.24em;border-radius:99px;
  color:#fff;background:linear-gradient(135deg,var(--red-hot),var(--red-deep));
  box-shadow:0 6px 18px rgba(217,4,41,.38);}
.diary-new:disabled{opacity:.45;box-shadow:none;}
.diary-loading{text-align:center;color:var(--coral);font-size:12px;letter-spacing:.2em;padding:30px 0;}

/* ================= 线下模式 ================= */
.irl-header{padding:12px 14px 10px;background:var(--glass);backdrop-filter:blur(14px);border-bottom:1px solid var(--hairline);
  z-index:6;display:flex;align-items:center;gap:10px;}
.irl-title{flex:1;font-size:14.5px;font-weight:600;letter-spacing:.12em;display:flex;align-items:baseline;gap:9px;min-width:0;}
.irl-sub{font-size:9px;letter-spacing:.26em;color:var(--coral);border:1px solid rgba(239,35,60,.4);border-radius:99px;padding:2px 9px;font-weight:400;}
.irl-restart{font-size:10px;letter-spacing:.12em;color:var(--ink-dim);border:1px solid var(--line);border-radius:99px;padding:6px 11px;flex-shrink:0;}
.irl-body{flex:1;overflow-y:auto;padding:22px 18px 14px;scrollbar-width:none;
  background:radial-gradient(130% 70% at 50% 0%,rgba(60,12,20,.5),transparent 60%);}
.irl-body::-webkit-scrollbar{display:none;}
.irl-para{margin-bottom:20px;font-size:15px;line-height:2.15;letter-spacing:.03em;word-break:break-word;white-space:pre-wrap;
  color:rgba(255,232,225,.92);animation:bubbleIn .5s ease;}
.irl-para.ta{text-align:justify;}
.irl-para.ta::first-letter{color:var(--ember);}
.irl-para.ta:before{content:'✦';color:var(--red-hot);margin-right:8px;font-size:12px;}
.irl-para.me{margin-left:26px;padding:13px 16px;border-left:2px solid var(--coral);
  background:linear-gradient(90deg,rgba(239,35,60,.1),transparent 70%);border-radius:0 14px 14px 0;
  color:#ffd9d0;text-align:justify;}
.irl-para.me:before{content:'你';display:inline-block;font-size:9px;letter-spacing:.1em;color:var(--ember);
  border:1px solid rgba(255,107,94,.5);border-radius:99px;padding:1px 8px;margin-right:8px;vertical-align:2px;}
.irl-dock{padding:8px 12px calc(12px + env(safe-area-inset-bottom));background:linear-gradient(180deg,transparent,rgba(10,3,6,.6) 30%);}

/* ---------- 纪念日动态 ---------- */
.mom-card.anniv{background:linear-gradient(135deg,rgba(217,4,41,.12),rgba(239,35,60,.03));
  border:1px solid rgba(239,35,60,.3);border-radius:16px;padding:16px 14px;margin-bottom:6px;}
.anniv-badge{display:inline-block;font-size:10px;letter-spacing:.18em;color:var(--ember);
  border:1px solid rgba(255,107,94,.45);border-radius:99px;padding:2px 10px;margin-bottom:7px;}
.mom-card.anniv .mom-text{font-size:14.5px;}
.mem-sec{font-size:10px;letter-spacing:.26em;color:var(--ink-dim);text-align:left;margin:16px 0 4px;
  padding-bottom:6px;border-bottom:1px solid var(--hairline);}

/* ================= 设置 ================= */
.settings-mask{position:absolute;inset:0;z-index:30;background:rgba(8,2,6,.55);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s;}
.settings-mask.show{opacity:1;visibility:visible;}
.settings-panel{position:absolute;top:0;left:0;bottom:0;z-index:31;width:min(88vw,352px);background:var(--panel);
  border-right:1px solid var(--line);transform:translateX(-102%);transition:transform .4s cubic-bezier(.2,.8,.25,1);display:flex;flex-direction:column;}
.settings-panel.show{transform:translateX(0);}
.settings-head{padding:22px 20px 16px;border-bottom:1px solid var(--hairline);display:flex;align-items:center;justify-content:space-between;}
.settings-head h3{font-size:15px;letter-spacing:.3em;color:var(--coral);}
.settings-close{font-size:17px;color:var(--ink-dim);padding:6px;}
.settings-body{flex:1;overflow-y:auto;padding:20px;}
.settings-body::-webkit-scrollbar{width:0;}
.setting-group{margin-bottom:26px;}
.group-label{font-size:10px;letter-spacing:.32em;text-indent:.32em;color:rgba(240,128,114,.66);margin-bottom:12px;}
.avatar-row{display:flex;align-items:center;gap:16px;}
.avatar-preview{width:64px;height:64px;border-radius:50%;border:1.5px solid rgba(240,128,114,.45);background:var(--red-deep);
  background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--hi);flex-shrink:0;}
.upload-btn{padding:8px 16px;font-size:12px;letter-spacing:.16em;text-indent:.16em;border:1px solid var(--line);border-radius:99px;color:var(--coral);}
.tip-mini{font-size:10px;color:var(--ink-dim);line-height:1.7;margin-top:6px;}
.ta-card{border:1px solid var(--hairline);border-radius:16px;padding:13px;margin-bottom:12px;background:rgba(255,255,255,.025);}
body.day .ta-card{background:rgba(120,30,45,.03);}
.ta-card.custom{border-color:rgba(232,62,78,.35);}
.ta-card-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.ta-avatar-mini{width:42px;height:42px;border-radius:50%;overflow:hidden;flex-shrink:0;border:1px solid rgba(240,128,114,.3);background:rgba(232,62,78,.08);display:flex;align-items:center;justify-content:center;position:relative;}
.ta-avatar-mini img{width:100%;height:100%;object-fit:cover;}
.ta-avatar-mini .star-svg{width:70%;height:70%;}
.ta-card-head .n{font-size:13px;font-weight:600;}
.ta-card-head .c{font-size:9px;letter-spacing:.18em;color:rgba(240,128,114,.55);}
.ta-card-head .ops{margin-left:auto;display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;max-width:150px;}
.mini-btn{font-size:10.5px;padding:5px 10px;border-radius:99px;border:1px solid var(--line);color:var(--coral);}
.mini-btn.ghost{color:var(--ink-dim);}
.mini-btn.danger{color:#ff8f86;border-color:rgba(255,110,100,.35);}
.persona-box{width:100%;min-height:96px;resize:vertical;background:rgba(232,62,78,.05);border:1px solid var(--hairline);border-radius:12px;
  color:var(--ink);font-size:12px;line-height:1.7;padding:10px 12px;outline:none;transition:border-color .3s;}
.persona-box:focus{border-color:rgba(240,128,114,.5);}
.add-ta-btn{width:100%;padding:13px;font-size:12px;letter-spacing:.24em;text-indent:.24em;border:1px dashed rgba(240,128,114,.5);
  border-radius:14px;color:var(--coral);}
.editor-card{border:1px solid rgba(239,35,60,.4);border-radius:16px;padding:14px;margin-bottom:12px;background:rgba(239,35,60,.05);display:none;}
.editor-card.show{display:block;animation:bubbleIn .3s ease;}
.swatches{display:flex;gap:9px;margin:4px 0 10px;flex-wrap:wrap;}
.swatch{width:27px;height:27px;border-radius:50%;border:2px solid transparent;display:flex;align-items:center;justify-content:center;}
.swatch.sel{border-color:var(--hi);box-shadow:0 0 10px rgba(239,35,60,.7);}
.editor-actions{display:flex;gap:8px;margin-top:10px;}
.editor-actions button{padding:10px 0;font-size:12px;letter-spacing:.2em;border-radius:99px;flex:1;}
.editor-save{background:linear-gradient(135deg,var(--red),var(--red-hot));color:#fff;}
.editor-cancel{border:1px solid var(--line);color:var(--ink-dim);}
.field{margin-bottom:14px;}
.field label{display:block;font-size:11px;color:var(--ink-dim);margin-bottom:7px;letter-spacing:.08em;}
.field input{width:100%;padding:10px 13px;background:rgba(232,62,78,.05);border:1px solid var(--hairline);border-radius:12px;color:var(--ink);font-size:13px;outline:none;transition:border-color .3s;}
.field input:focus{border-color:rgba(240,128,114,.5);}
.field input::placeholder{color:rgba(180,130,120,.5);}
.field-row2{display:flex;gap:8px;align-items:center;}
.field-row2 .field{flex:1;margin:0;}
.test-btn{padding:10px 14px;font-size:11.5px;border-radius:12px;border:1px solid var(--line);color:var(--coral);white-space:nowrap;align-self:flex-end;}
#api-test-result{font-size:10.5px;line-height:1.7;margin-top:8px;color:var(--ink-dim);}
#api-test-result.ok{color:#8fd6a8;}
#api-test-result.err{color:#ff9a8f;}
.switch-row{display:flex;align-items:center;justify-content:space-between;}
.switch-row span{font-size:13px;}
.switch{position:relative;width:46px;height:25px;border-radius:20px;background:rgba(232,62,78,.25);transition:background .3s;flex-shrink:0;}
.switch::after{content:"";position:absolute;top:3px;left:3px;width:19px;height:19px;border-radius:50%;background:var(--mist);transition:transform .3s;}
.switch.on{background:linear-gradient(135deg,var(--red),var(--red-hot));}
.switch.on::after{transform:translateX(21px);background:var(--hi);}
.reset-btn{width:100%;padding:10px;font-size:11px;letter-spacing:.18em;text-indent:.18em;border:1px dashed var(--line);border-radius:12px;color:var(--ink-dim);}
.mem-item{text-align:left;font-size:12.5px;line-height:1.8;color:var(--ink);padding:10px 2px;border-bottom:1px solid var(--hairline);display:flex;gap:10px;}
.mem-item:last-child{border-bottom:none;}
.mem-item .mt{color:var(--ink-dim);font-size:10px;flex-shrink:0;padding-top:2px;white-space:nowrap;}
.mem-empty{font-size:12px;color:var(--ink-dim);padding:24px 0;letter-spacing:.1em;}

#toast{position:absolute;left:50%;bottom:120px;transform:translate(-50%,14px);z-index:60;
  background:rgba(28,8,14,.96);border:1px solid var(--line);color:var(--hi);font-size:12px;letter-spacing:.1em;
  padding:10px 22px;border-radius:99px;opacity:0;visibility:hidden;transition:all .35s;pointer-events:none;white-space:nowrap;max-width:90%;}
#toast.show{opacity:1;visibility:visible;transform:translate(-50%,0);}
</style>
</head>
<body>
<div id="app">
  <div class="nebula n1"></div>
  <div class="nebula n2"></div>
  <div id="starfield"></div>

  <!-- 开场 -->
  <section id="opening" class="screen active">
    <div class="opening-title">PARALLEL UNIVERSE</div>
    <div class="su-stage">
      <div class="orbit-ring ring-o"><span class="orbit-planet"></span></div>
      <div class="orbit-ring ring-m"><span class="orbit-planet"></span></div>
      <div class="orbit-ring ring-i"><span class="orbit-planet"></span></div>
      <div class="su-wrap">
        <svg class="su-svg" viewBox="0 0 240 130">
          <defs><linearGradient id="suInk" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffe9df"/><stop offset=".45" stop-color="#ef3b4d"/><stop offset="1" stop-color="#a8001f"/>
          </linearGradient></defs>
          <path class="su-stroke s1" pathLength="100"
            d="M12,88 C26,72 24,46 50,38 C78,30 108,37 106,55 C104,68 72,67 66,79 C59,95 95,103 124,90 C140,83 142,68 137,54"/>
          <path class="su-stroke s2" pathLength="100"
            d="M150,35 C147,64 147,90 160,101 C172,111 192,108 200,95 C208,82 205,58 207,36 C211,56 220,72 235,70"/>
        </svg>
        <span class="su-spark">✦</span>
      </div>
    </div>
    <div class="loading-wrap">
      <div class="loading-bar"><div class="loading-fill" id="loading-fill"></div></div>
      <div class="loading-pct"><span id="loading-pct">0</span>%</div>
      <button class="enter-btn" id="enter-btn">进 入 宇 宙</button>
    </div>
  </section>

  <!-- 星图 -->
  <section id="main" class="screen">
    <div class="main-header">
      <div class="en">SU Universe</div>
      <div class="sub">同 一 个 人 · 无 数 种 心 跳</div>
    </div>
    <div class="universe-stage"><div class="u-orbit" id="u-orbit"></div></div>
    <div class="main-hint">选 一 颗 星 · 开 始 聊 天</div>
    <button class="fab" id="open-settings"><span style="font-size:19px;">⚙</span><span class="mini-avatar" id="mini-avatar">我</span></button>
    <button class="fab" id="open-moments">动 态<span id="moments-dot"></span></button>
  </section>

  <!-- 角色弹窗 -->
  <div class="mask" id="popup-mask">
