  clearInterval(callState.timer);
  callState.timer=setInterval(()=>{callState.sec++;$('call-status').textContent='通话中 '+fmtClock(callState.sec);},1000);
  callAsk(true);
}
function callAppend(m){
  const body=$('call-body'),segs=msgSegments(m);
  segs.forEach((s,i)=>setTimeout(()=>{
    if(!$('call-mask').classList.contains('show'))return;
    body.appendChild(buildSegWrap(callState.u,m.r,s,{nomid:i>0}));
    callScroll();
  },i*340));
}
function callShowTyping(){
  const wrap=document.createElement('div');wrap.className='msg ta';
  const av=document.createElement('div');av.className='msg-avatar';
  const b=document.createElement('div');b.className='bubble typing';b.innerHTML='<i></i><i></i><i></i>';
  wrap.appendChild(av);wrap.appendChild(b);
  $('call-body').appendChild(wrap);callScroll();return wrap;
}
async function callAsk(first){
  if(callState.busy)return;
  callState.busy=true;$('call-send').disabled=true;
  const typing=callShowTyping();
  try{
    const extra='【正在打电话】\n你们正在语音通话 用打电话的方式打字交流 他此刻在听筒那头。说话要像耳边说话：极短 极即时 口语化 有停顿和语气词 一次一两句 可以带当下环境里的声音和动作（走路声 风声 关门声） 不要书面表达。'
      +(first?'\n电话刚接通 你先开口 一个“喂”或者喊她名字都可以 不要解释':'');
    const p=await requestReply(callState.u,callState.items,extra,
      {system:buildSystem(callState.u,extra,{chat:true}),kick:first?'[电话接通了 你先开口 不要解释任何东西]':null,maxTokens:220});
    const reply=(p.reply||'').trim();if(!reply)throw new Error('返回内容为空');
    let segs=p.lines.length?p.lines:splitReplyBubbles(reply);
    segs=segs.map(s=>String(s).trim()).filter(Boolean).slice(0,3);if(!segs.length)segs=[reply];
    const ob={r:'a',t:segs.join('\n'),ts:Date.now()};if(segs.length>1)ob.seg=segs;
    callState.items.push(ob);
    typing.remove();callAppend(ob);
    if(typeof p.delta==='number'&&p.delta!==0){applyAffinity(callState.u,p.delta);}
    if(p.memory&&String(p.memory).trim())addMemory(callState.u,String(p.memory).trim());
    if(p.fact&&String(p.fact).trim())addFact(callState.u,String(p.fact).trim());
    save();
  }catch(err){
    typing.remove();
    const w=buildSegWrap(callState.u,'a','',{});
    w.querySelector('.bubble').innerHTML='<div class="err-bubble">信号不好 他没听清<br><button id="call-retry">再 说 一 遍</button></div>';
    $('call-body').appendChild(w);callScroll();
    w.querySelector('#call-retry').addEventListener('click',()=>{w.remove();callAsk(first);});
  }finally{callState.busy=false;$('call-send').disabled=!$('call-input').value.trim();}
}
function callSend(){
  const t=$('call-input').value.trim();
  if(!t||callState.busy)return;
  callState.items.push({r:'u',t,ts:Date.now()});
  $('call-input').value='';$('call-input').style.height='auto';
  $('call-body').appendChild(buildSegWrap(callState.u,'u',t,{}));callScroll();
  callAsk(false);
}
