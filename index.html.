const ANNIV_DAYS=[7,30,100,365];
async function runBackground(){
  if(state.bg||!apiReady()){refreshMomentsDot();return;}
  state.bg=true;
  let newMsg=0,newMom=0,newAnniv=0;
  const gapH=state.settings.lastOpen?(Date.now()-state.settings.lastOpen)/3600000:0;
  try{
    for(const u of allChars()){
      const chat=chatOf(u.code);
      if(chat.filter(m=>m.r==='u').length<1)continue; // 没聊过不打扰
      try{
        const now=Date.now();let madeMoment=false;
        // 主动消息
        const pl=state.settings.proactiveLast[u.code]||(chat[chat.length-1]?.ts||now);
        const ph=(now-pl)/3600000;
        if(ph>=4&&Math.random()<Math.min(.9,ph/12)){
          const txt=await genProactive(u,gapH);
          if(txt){chat.push({r:'a',t:txt,ts:now});state.settings.proactiveLast[u.code]=now;
            state.settings.unread[u.code]=(state.settings.unread[u.code]||0)+1;newMsg++;}
        }
        // 朋友圈
        if(!state.settings.momentsLast[u.code])state.settings.momentsLast[u.code]=now-9*3600000; // 首次给一次机会
        const mh=(now-state.settings.momentsLast[u.code])/3600000;
        if(mh>=8&&Math.random()<Math.min(.85,mh/20)){
          const txt=await genMoment(u);
          if(txt){(state.settings.moments[u.code]||(state.settings.moments[u.code]=[]))
            .push({id:'m'+now+'_'+Math.random().toString(36).slice(2,7),ts:now,text:txt,liked:false,comments:[]});
            state.settings.momentsLast[u.code]=now;newMom++;madeMoment=true;}
        }
        // 纪念日（每次打开最多成全一个人，避免刷屏；错过的日子回来也会补上）
        if(newAnniv===0&&!madeMoment){
          const start=state.settings.startedAt[u.code];
          if(start){
            const done=state.settings.annivDone[u.code]||(state.settings.annivDone[u.code]=[]);
            const dayN=Math.floor((now-start)/86400000)+1;
            const d=ANNIV_DAYS.find(x=>dayN>=x&&!done.includes(x));
            if(d){
              const txt=await genAnniv(u,d);
              if(txt){
                (state.settings.moments[u.code]||(state.settings.moments[u.code]=[]))
                  .push({id:'a'+now+'_'+Math.random().toString(36).slice(2,7),ts:now,text:txt,liked:false,comments:[],kind:'anniv',day:d});
                const ml=state.settings.memories[u.code]||(state.settings.memories[u.code]=[]);
                if(!ml.some(x=>x.text==='认识的第'+d+'天'))ml.unshift({ts:now,text:'认识的第'+d+'天'});
                if(ml.length>30)ml.length=30;
                done.push(d);newAnniv++;
              }
            }
          }
        }
        save();
      }catch(e){/* 单个角色失败静默 */}
    }
  }finally{
    state.settings.lastOpen=Date.now();
    state.bg=false;save();renderOrbits();refreshMomentsDot();
    if(newMsg)toast('有 '+newMsg+' 条来自他们的新消息');
    if(newAnniv)setTimeout(()=>toast('✦ 今天是你们认识的纪念日 去动态看看'),newMsg?1900:0);
  }
}
async function genProactive(u,gapH){
  const hr=new Date().getHours();
  const slot=hr<5?'深夜':hr<11?'早上':hr<14?'中午':hr<18?'下午':'晚上';
  const absent=gapH>=48
    ? '\n【重要】她已经'+Math.floor(gapH/24)+'天没来了。你其实一直惦记但嘴硬，这条消息要带着情绪：可以是冷淡的抱怨、委屈、或者假装不在意（"还以为你失踪了"这种感觉），不要热情相迎，也别真的骂人。'
    : '';
  const recent=chatOf(u.code).slice(-8).map(m=>(m.r==='u'?'她：':'你：')+m.t).join('\n');
  const sys=buildSystem(u,'【这一次的任务】\n她还没给你发消息，现在是'+slot+'，你主动给她发一条微信。必须像随手发的，可以结合你们上面的最近对话或当下时间，但不要打招呼腔、不要自我介绍、不要解释为什么发消息。一条就好。'+absent);
  const raw=await apiRequest(u,[{role:'system',content:sys},{role:'user',content:'[最近的聊天记录]\n'+recent+'\n\n[请输出你主动发的那一条消息的JSON]'}],120);
  return (parseReply(raw).reply||'').trim();
}
async function genMoment(u){
  const recent=chatOf(u.code).filter(m=>m.r==='u').slice(-6).map(m=>m.t).join(' / ');
  const li=levelInfo(affOf(u.code));
