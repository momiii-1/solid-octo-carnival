const callState={u:null,items:[],busy:false,timer:null,sec:0};
function fmtClock(s){return ('0'+Math.floor(s/60)).slice(-2)+':'+('0'+(s%60)).slice(-2);}
function callScroll(){const b=$('call-body');b.scrollTop=b.scrollHeight;}
function startCall(u){
  if(!apiReady()){toast('请先配置 AI 接口');return;}
  callState.u=u;callState.items=[];callState.busy=false;callState.sec=0;
  $('call-avatar').innerHTML=taAvatarHTML(u);
