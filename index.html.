function crossSceneBlock(u,opts){
  opts=opts||{};const parts=[];
  if(opts.chat){
    const recent=chatOf(u.code).slice(-8).map(m=>(m.r==='u'?'她：':'你：')+String(m.t).replace(/\s+/g,' ')).join('\n');
