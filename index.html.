    }
    if(mode==='daily')extra+='【这一次的任务】\n主动问她一个小问题 关于她的日常 喜好 想法或者小时候的小事 轻松一点 符合你们的关系阶段 别像查户口 也不要重复上面聊天记录里已经问过的 可以带一两句铺垫 短一点 这次只发一条\n';
    if(mode==='answer')extra+='【她在认真回答你刚才问的问题】\n先接住她的答案给真实反应 意外 开心 调侃 追问都可以 别让她觉得白说了\n';
    const kick=isGreet?'[场景：这是你们第一次对上话。请你完全用角色的口吻，自然地开场，可以带一点当下的日常感，不要解释任何东西。]':null;
    const parsed=await requestReply(u,chatOf(u.code),extra,{kick});
    const reply=parsed.reply.trim();
    if(!reply)throw new Error('返回内容为空');
    let segs=(parsed.lines&&parsed.lines.length)?parsed.lines:splitReplyBubbles(reply);
    segs=segs.map(s=>String(s).trim()).filter(Boolean).slice(0,3);
    if(!segs.length)segs=[reply];
    if(mode==='daily')segs=segs.slice(0,1);
    const ob={r:'a',t:segs.join('\n'),ts:Date.now()};
    if(segs.length>1)ob.seg=segs;
    if(mode==='daily'){ob.q=1;state.settings.dailyLast[u.code]=todayKey();}
    chatOf(u.code).push(ob);
    // 他回消息了 她之前发的都算已读
    chatOf(u.code).forEach(m=>{if(m.r==='u')m.rd=1;});
    save();
    removeTyping(typing);appendTaBubbles(u,ob);
    if(mode!=='daily'){
      if(typeof parsed.delta==='number'&&parsed.delta!==0){
        const before=affOf(u.code),cur=Math.max(0,Math.min(1000,before+parsed.delta));
        if(cur!==before){
          state.settings.affinity[u.code]=cur;
          updateMoodAfter(u.code,cur-before);
          if(parsed.memory&&String(parsed.memory).trim())addMemory(u,String(parsed.memory).trim());
          save();updateAffUI();applyMoodStatus();floatScore(cur-before);
          const a=levelInfo(cur),b=levelInfo(before);
          if(a.lv!==b.lv)setTimeout(()=>toast('Lv.'+a.lv+' · '+a.stage+(a.stage!==b.stage?'阶段':'')),700);
        }
      }
      if(parsed.fact&&String(parsed.fact).trim()){addFact(u,String(parsed.fact).trim());save();}
      // 每日一问的回答：额外 +5 心动，问题标记为已答
      if(mode==='answer'){
        const qm=[...chatOf(u.code)].reverse().find(m=>m.q===1);
        if(qm){
          qm.q=2;
          const before=affOf(u.code),cur=Math.min(1000,before+5);
          if(cur!==before){state.settings.affinity[u.code]=cur;updateMoodAfter(u.code,5);}
          save();updateAffUI();applyMoodStatus();
          if(cur!==before)setTimeout(()=>floatScore(5),650);
        }
      }
    }
  }catch(err){removeTyping(typing);showError(u,err,isGreet,mode);}
  finally{state.busy=false;refreshSend();applyMoodStatus();refreshDailyChip();}
}
function parseReply(raw){
  let s=raw.trim().replace(/^```(?:json)?/i,'').replace(/```$/,'').trim();
  const i=s.indexOf('{'),j=s.lastIndexOf('}');
  if(i>=0&&j>i){
    const frag=s.slice(i,j+1);
    for(const cand of [frag,frag.replace(/,\s*([}\]])/g,'$1')]){
      try{const o=JSON.parse(cand);
        if(typeof o==='object'&&o!==null)return {
          reply:String(o.reply??o.message??(Array.isArray(o.lines)?o.lines.join('\n'):raw)),
          lines:Array.isArray(o.lines)?o.lines.map(x=>String(x)):[],
          delta:Number(o.delta)||0,memory:o.memory?String(o.memory):'',fact:o.fact?String(o.fact):''};
      }catch(_){}
    }
  }
  return {reply:raw,lines:[],delta:1,memory:'',fact:''};
}
